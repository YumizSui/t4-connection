#!/usr/bin/env bash
source "$(cd "$(dirname "$0")/../lib" && pwd)/common.sh"
usage() { printf '%s\n' 'Usage: t4-start [--dry-run] [--open-browser|--no-open-browser] [hours:1-24] [code-server|sshd|both]' 'Defaults: T4_START_HOURS (20), T4_START_SERVICE (both), T4_OPEN_BROWSER (true). Explicit arguments override config; code-server forwarding uses T4_LOCAL_PORT.'; }
dry=false
open_browser=${T4_OPEN_BROWSER:-true}
positionals=()
for arg in "$@"; do
    case $arg in
        --help|-h) usage; exit 0 ;;
        --dry-run) dry=true ;;
        --open-browser) open_browser=true ;;
        --no-open-browser) open_browser=false ;;
        --*) usage >&2; exit 2 ;;
        *) positionals+=("$arg") ;;
    esac
done
set -- "${positionals[@]}"
[[ $open_browser == true || $open_browser == false ]] || fail 'T4_OPEN_BROWSER must be true or false.'
hours=${1:-${T4_START_HOURS:-20}}
service=${2:-${T4_START_SERVICE:-both}}
[[ $# -le 2 && $hours =~ ^([1-9]|1[0-9]|2[0-4])$ ]] || { usage >&2; exit 2; }
[[ $service == code-server || $service == sshd || $service == both ]] || { usage >&2; exit 2; }
remote="exec bash -lc 'cd \"\$HOME\" && exec iqrsh -l h_rt=$hours:00:00 -cwd -pty y /usr/bin/env SHELL=/bin/bash /bin/bash -l .local/share/t4-connection/remote/start-session $service'"
args=(ssh -tt -o ControlPersist=no -o ConnectionAttempts=1 "$T4_LOGIN" "$remote")
if "$dry"; then
    printf '%q ' "${args[@]}"; printf '\n'
    [[ $service == sshd ]] || printf 'After code-server starts, forward localhost:%s to its remote port.\n' "$T4_LOCAL_PORT"
    if [[ $service != sshd && $open_browser == true ]]; then
        printf 'After HTTP is ready, open http://localhost:%s in the browser.\n' "$T4_LOCAL_PORT"
    fi
    [[ $service == code-server ]] || printf 'After sshd starts, register dynamic Host t4-compute in ~/.ssh/config.\n'
    exit 0
fi
[[ $service == sshd ]] || port "$T4_LOCAL_PORT"
launch_browser() {
    local url=http://localhost:$T4_LOCAL_PORT status attempt
    # Forward setup alone does not prove HTTP is reachable through the tunnel.
    for (( attempt=0; attempt<10; attempt++ )); do
        kill -0 "$job_pid" 2>/dev/null || return 1
        status=$(curl --noproxy '*' -s -o /dev/null -w '%{http_code}' --max-time 2 "http://127.0.0.1:$T4_LOCAL_PORT/") || status=000
        case $status in
            2??|3??|401|403)
                if [[ $(uname -s) == Darwin ]]; then
                    open "$url"
                elif command -v wslview >/dev/null 2>&1; then
                    wslview "$url"
                elif command -v cmd.exe >/dev/null 2>&1; then
                    cmd.exe /c start "" "$url"
                else
                    xdg-open "$url"
                fi
                return $? ;;
        esac
        sleep 0.2
    done
    return 1
}
umask 077
# Own this master so automatic forwarding ends with this job, not another session.
session_dir=$(mktemp -d "${TMPDIR:-/tmp}/t4-start.XXXXXXXX")
control=$session_dir/control
session_log=$session_dir/session.log
: > "$session_log"
job_pid=
log_pid=
cleanup() {
    trap - EXIT INT TERM HUP
    if [[ -n $job_pid ]]; then kill "$job_pid" 2>/dev/null || :; wait "$job_pid" 2>/dev/null || :; fi
    if [[ -n $log_pid ]]; then kill "$log_pid" 2>/dev/null || :; wait "$log_pid" 2>/dev/null || :; fi
    rm -f "$control" "$session_log"
    rmdir "$session_dir"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP
ssh -S "$control" -o ControlMaster=yes -o ControlPersist=no -o ConnectionAttempts=1 \
    -o ExitOnForwardFailure=yes -tt "$T4_LOGIN" "$remote" <&0 > "$session_log" 2>&1 &
job_pid=$!
tail -n +1 -f "$session_log" &
log_pid=$!
forward_attempted=false
config_attempted=false
[[ $service != sshd ]] || forward_attempted=true
[[ $service != code-server ]] || config_attempted=true
while kill -0 "$job_pid" 2>/dev/null; do
    if ! "$config_attempted"; then
        ready=$(tr -d '\r' < "$session_log" | grep '^T4_READY sshd ' | tail -n 1 || :)
        if [[ $ready =~ ^T4_READY\ sshd\ (r[0-9]+n[0-9]+)\ ([0-9]{4,5})\ ([0-9]+)$ ]]; then
            config_attempted=true
            if ! "$(dirname "$0")/t4-ssh-config"; then
                printf '\nAutomatic SSH config update failed; the remote job is still running.\nRun t4-ssh-config after resolving the error.\n' >&2
            fi
        fi
    fi
    if ! "$forward_attempted"; then
        ready=$(tr -d '\r' < "$session_log" | grep '^T4_READY code-server ' | tail -n 1 || :)
        if [[ $ready =~ ^T4_READY\ code-server\ (r[0-9]+n[0-9]+)\ ([0-9]{4,5})\ ([0-9]+)$ ]]; then
            node=${BASH_REMATCH[1]}
            remote_port=${BASH_REMATCH[2]}
            port "$remote_port"
            forward_attempted=true
            if ssh -S "$control" -O forward -o ExitOnForwardFailure=yes \
                -L "127.0.0.1:$T4_LOCAL_PORT:$node:$remote_port" "$T4_LOGIN"; then
                printf '\nOpen http://127.0.0.1:%s (forwarding to %s:%s).\n' "$T4_LOCAL_PORT" "$node" "$remote_port"
                if "$open_browser"; then
                    if ! launch_browser; then
                        printf 'Browser auto-open failed or HTTP is not ready; the job and forwarding are retained. Open http://localhost:%s manually.\n' "$T4_LOCAL_PORT" >&2
                    fi
                fi
            else
                printf '\nAutomatic forwarding failed; the remote job is still running.\nUse t4-forward <another-local-port> in another terminal.\n' >&2
            fi
        fi
    fi
    sleep 0.2
done
result=0
wait "$job_pid" || result=$?
job_pid=
exit "$result"
